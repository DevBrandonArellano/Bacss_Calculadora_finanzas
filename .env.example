# Persistencia remota de comparaciones (opcional — ver ADR 0013).
# Sin estas variables, la app funciona igual pero solo guarda en localStorage.
#
# IMPORTANTE (ADR 0012): estas variables se empaquetan en el bundle público.
# Solo va aquí la "anon key" de Supabase, NUNCA la "service_role" key, y solo
# tiene sentido si Row Level Security está activado en la tabla `scenarios`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
